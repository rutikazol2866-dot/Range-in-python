   "source": [
    "# Write a program given no is prime or not."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e4c25a24",
   "metadata": {},
   "outputs": [],
   "source": [
    "num = int(input(\"Enter a number\"))\n",
    "count = 0\n",
    "for i in range(2,num):\n",
    "    if num % i == 0:\n",
    "        count = count +1\n",
    "if count == 0 and num > 1:\n",
    "    print(\"prime\")\n",
    "else:\n",
    "    print(\"not prime\")            "
   ]
  }
